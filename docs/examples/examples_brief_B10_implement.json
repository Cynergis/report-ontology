   "id": "CQ04",
   "question": "Which checks gate this step: what does each measure, against which threshold, and what happens on failure?",
   "required": true,
   "status": "answered",
   "answer": [
    {
     "check": "pt:step/B10_verify/check/fidelity",
     "checkId": "fidelity",
     "kind": "metric",
     "expression": "metrics.fidelity_missing == 0",
     "metric": "fidelity_missing",
     "parameter": null,
     "paramValue": null,
     "blocking": "true",
     "onFail": "fail"
    },
    {
     "check": "pt:step/B10_verify/check/overflow",
     "checkId": "overflow",
     "kind": "metric",
     "expression": "metrics.overflow_count == 0",
     "metric": "overflow_count",
     "parameter": null,
     "paramValue": null,
     "blocking": "true",
     "onFail": "fail"
    },
    {
     "check": "pt:step/B10_verify/check/similarity",
     "checkId": "similarity",
     "kind": "metric",
     "expression": "metrics.region_ssim_min >= (config.ssim_region_min_vector if state.nodes.B01_inspect.metrics.raster_pages == 0 else config.ssim_region_min_raster)",
     "metric": "region_ssim_min",
     "parameter": "ssim_region_min_raster",
     "paramValue": "0.6",
     "blocking": "state.nodes.B01_inspect.metrics.raster_pages == 0 or config.ssim_blocking_for_raster",
     "onFail": "fail"
    },
    {
     "check": "pt:step/B10_verify/check/similarity",
     "checkId": "similarity",
     "kind": "metric",
     "expression": "metrics.region_ssim_min >= (config.ssim_region_min_vector if state.nodes.B01_inspect.metrics.raster_pages == 0 else config.ssim_region_min_raster)",
     "metric": "region_ssim_min",
     "parameter": "ssim_region_min_vector",
     "paramValue": "0.85",
     "blocking": "state.nodes.B01_inspect.metrics.raster_pages == 0 or config.ssim_blocking_for_raster",
