  {
   "id": "CQ01",
   "question": "What is this step for, and what kind of executor runs it?",
   "required": true,
   "status": "answered",
   "answer": [
    {
     "step": "pt:step/B10_verify",
     "stepId": "B10_verify",
     "name": "Verify render vs source",
     "type": "flow:DeterministicStep",
     "description": "Five checks, per region (regions come from the blueprint, so a failure names the component to fix): overflow (content larger than its box), data fidelity (every slot value is in the PDF text layer inside its region), visibility (OCR of the rendered image finds the value, which catches text clipped by CSS but still in the text layer), visual similarity (SSIM per region against the source) and style (font size and color against tokens).",
     "usesOcr": "true",
     "foreach": null
    }
   ],
   "gaps": []
  },
  {
