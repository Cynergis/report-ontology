  {
   "id": "CQ10",
   "question": "Which domain concepts do its inputs and outputs carry, and what do they mean?",
   "required": true,
   "status": "answered",
   "answer": [
    {
     "artifact": "pt:artifact/blueprint",
     "concept": "dt:Blueprint",
     "label": "Blueprint",
     "definition": "The semantic model of a page: each region labeled with a component, each text span classified as static or as the source of a named slot, and the repeat structure."
    },
    {
     "artifact": "pt:artifact/blueprint",
     "concept": "dt:Component",
     "label": "Component",
     "definition": "A reusable visual box type (returns table, allocation list, bar chart, key-value list…). One component = one template macro."
    },
    {
     "artifact": "pt:artifact/blueprint",
     "concept": "dt:Slot",
     "label": "Slot",
     "definition": "A named place where data goes, with a type and a repeat flag. Every slot becomes one data-schema field."
    },
    {
     "artifact": "pt:artifact/blueprint",
     "concept": "dt:StaticText",
     "label": "Static text",
     "definition": "Text that is part of the design (labels, headings, disclaimers); it becomes an i18n label, never data."
    },
    {
     "artifact": "pt:artifact/page_images",
     "concept": "dt:PageImage",
     "label": "Page image",
     "definition": "A raster of a page at a known dpi; the visual reference every comparison uses."
    },
    {
     "artifact": "pt:artifact/region_crops",
     "concept": "dt:RegionCrop",
     "label": "Region crop",
     "definition": "Side-by-side source|render image of one failing region, given to repair."
    },
    {
     "artifact": "pt:artifact/render_outputs",
     "concept": "dt:RenderedDocument",
     "label": "Rendered document",
     "definition": "HTML, PDF and PNG produced by rendering a data document through a template project with headless Chromium."
    },
    {
     "artifact": "pt:artifact/sample_data",
     "concept": "dt:SampleData",
     "label": "Sample data",
     "definition": "The source PDF's own data, filled by code from its text; rendering it must reproduce the source."
    },
    {
     "artifact": "pt:artifact/tokens_draft",
     "concept": "dt:DesignToken",
     "label": "Design token",
     "definition": "A named, measured style value (color, font family, size, spacing, rule width) reused across the template."
    },
    {
     "artifact": "pt:artifact/verify_report",
     "concept": "dt:VerificationResult",
     "label": "Verification result",
     "definition": "Per-region results of comparing a render to its reference and its data: overflow, fidelity, visibility, similarity, style."
    }
   ],
   "gaps": []
