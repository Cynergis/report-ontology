{
  "_about": "What this ontology exists to answer. Each question runs over the graph in the pattern language of rules.json; `gate` says what an empty answer means; `gaps` says why it is empty; `terms` names the vocabulary the question covers. Reasoned about in `why`, confirmed in `validated_by`.",
  "questions": {
    "Q1": {
      "who": "analyst",
      "question": "Which report types exist: what is each for, for whom, in which locales and formats, how often, and where is it in its lifecycle?",
      "why": "Q1 of Gate 1 (confirmed 2026-10-07): the catalogue is the first thing a reader asks for.",
      "validated_by": "",
      "ask": {
        "when": [
          {
            "node": "r",
            "type": "ReportType"
          },
          {
            "optional": [
              {
                "edge": [
                  "r",
                  "releasedAs",
                  "rel"
                ]
              },
              {
                "node": "rel",
                "type": "TemplateRelease"
              },
              {
                "optional": [
                  {
                    "edge": [
                      "rel",
                      "hasSchedule",
                      "s"
                    ]
                  },
                  {
                    "node": "s",
                    "type": "Schedule"
                  }
                ]
              }
            ]
          }
        ],
        "select": [
          "r.reportId",
          "r.label",
          "r.purpose",
          "r.kind",
          "r.audience",
          "r.locale",
          "r.cadence",
          "s.cadence",
          "r.lifecycleStatus",
          "r.owner",
          "rel.version",
          "rel.frozen"
        ]
      },
      "gate": "non_empty",
      "terms": [
        "ReportType.version",
        "ReportType.layout"
      ]
    },
    "Q2": {
      "who": "operations",
      "question": "What identifies one document of $REPORT, and where do the allowed values of each identifier come from at run time?",
      "why": "Q2 of Gate 1 (confirmed 2026-10-07): a batch is expanded from the identifiers' universes.",
      "validated_by": "",
      "params": {
        "REPORT": {
          "type": "ReportType"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$REPORT",
              "hasParameter",
              "p"
            ]
          },
          {
            "node": "p",
            "type": "Parameter"
          },
          {
            "optional": [
              {
                "edge": [
                  "p",
                  "universeQuery",
                  "u"
                ]
              },
              {
                "node": "u",
                "type": "UniverseQuery"
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "p",
                  "boundToColumn",
                  "c"
                ]
              },
              {
                "node": "c",
                "type": "Column"
              }
            ]
          }
        ],
        "select": [
          "p.label",
          "p.definition",
          "p.allowedValue",
          "p.boundBy",
          "u.label",
          "u.sql",
          "u.returnsParameter",
          "c.columnName"
        ]
      },
      "gate": "non_empty",
      "gaps": [
        {
          "when": [
            {
              "not_edge": [
                "$REPORT",
                "hasParameter",
                "*"
              ]
            }
          ],
          "say": "nothing identifies a document of the report"
        },
        {
          "when": [
            {
              "edge": [
                "$REPORT",
                "hasParameter",
                "p"
              ]
            },
            {
              "node": "p",
              "type": "Parameter",
              "where": {
                "allowedValue": {
                  "exists": false
                },
                "boundBy": {
                  "exists": false
                }
              }
            },
            {
              "not_edge": [
                "p",
                "universeQuery",
                "*"
              ]
            }
          ],
          "say": "a parameter has no universe: a batch cannot be expanded"
        }
      ]
    },
    "Q3": {
      "who": "analyst",
      "question": "What does field $FIELD mean, and what label does it carry, in each language the report is offered in?",
      "why": "Q3 of Gate 1 (confirmed 2026-10-07): a field's meaning per locale is what the report promises its reader.",
      "validated_by": "",
      "params": {
        "FIELD": {
          "type": "Field"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$FIELD",
              "hasMeaning",
              "m"
            ]
          },
          {
            "node": "m",
            "type": "FieldMeaning"
          }
        ],
        "select": [
          "m.locale",
          "m.label",
          "m.definition"
        ]
      },
      "gate": "non_empty",
      "gaps": [
        {
          "when": [
            {
              "edge": [
                "$FIELD",
                "inReport",
                "r"
              ]
            },
            {
              "node": "r",
              "type": "ReportType",
              "where": {
                "locale": {
                  "contains": "fr"
                }
              }
            },
            {
              "not_edge": [
                "$FIELD",
                "hasMeaning",
                "*"
              ]
            }
          ],
          "say": "no meaning in a language the report is offered in"
        }
      ]
    },
