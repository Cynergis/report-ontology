          },
          {
            "node": "c",
            "type": "Macro"
          },
          {
            "edge": [
              "$FIELD",
              "inReport",
              "r"
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "r",
                  "releasedAs",
