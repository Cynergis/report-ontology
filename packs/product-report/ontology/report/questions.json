    "Q16": {
      "who": "analyst",
      "question": "Has anything about field $FIELD changed in any report: its meaning, label, type or column; what was it before, and since when?",
      "why": "Q16 of Gate 1 (confirmed 2026-10-07): before trusting a figure, an analyst must know whether its meaning or column moved.",
      "validated_by": "",
      "params": {
        "FIELD": {
          "type": "Field"
        }
      },
      "ask": {
        "when": [
          {
            "node": "r",
            "type": "ReportType"
          },
          {
            "edge": [
              "r",
              "hasRevision",
              "v"
            ]
          },
          {
            "node": "v",
            "type": "Revision"
          },
          {
            "edge": [
              "v",
              "hasChange",
              "c"
            ]
          },
          {
            "node": "c",
            "type": "Change",
            "where": {
              "fact": {
                "contains": "fields.$FIELD.fieldId."
              }
            }
          }
        ],
        "select": [
          "r.reportId",
          "v.order",
          "v.at",
          "v.effectiveFrom",
          "v.changedBy",
          "v.reason",
          "c.fact",
          "c.changeKind",
          "c.previousValue",
          "c.newValue"
        ]
      },
      "gate": "any",
      "gaps": [
        {
          "when": [
            {
              "edge": [
                "$FIELD",
                "inReport",
                "r"
              ]
            },
            {
              "not_edge": [
                "r",
                "hasRevision",
                "*"
              ]
            }
          ],
          "say": "the report keeps no history: earlier changes to this field were not recorded"
        }
      ]
    },
