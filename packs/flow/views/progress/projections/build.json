   "name": "$label",
   "summary": "$summary",
   "format": "$attr.format",
   "optional": "$attr.optional",
   "written_by": {
    "$in": "writes",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   },
   "read_by": {
    "$in": "reads",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   },
   "fields": {
    "$out": "hasArtifactField",
    "$select": {
     "name": "$label",
     "path": "$attr.fieldPath"
    }
   }
  }
 },
 "settings": {
  "$nodes": "ConfigParameter",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "name": "$label",
   "summary": "$summary",
   "value": "$attr.value",
   "param": "$attr.paramName",
   "used_by": {
    "$in": "usesParameter",
    "$select": {
     "id": "$id",
     "name": "$label",
     "type": "$type"
    }
   },
   "compared_by": {
    "$in": "comparedTo",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   }
  }
 },
 "checks": {
  "$nodes": "Check",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "name": "$label",
   "summary": "$summary",
   "blocking": "$attr.blocking",
   "kind": "$attr.checkKind",
   "on": {
    "$in": "hasCheck",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   },
   "against": {
    "$out": "comparedTo",
    "$select": {
     "id": "$id",
     "name": "$label",
     "value": "$attr.value"
    }
   },
   "on_fail": {
    "$out": "onFail",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   },
   "enforces": {
    "$in": "enforcedBy",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   }
  }
 },
 "obligations": {
  "$nodes": "TestObligation",
