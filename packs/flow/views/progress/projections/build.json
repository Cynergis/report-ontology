{
 "flows": {
  "$nodes": "Flow",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "name": "$label",
   "summary": "$summary",
   "value": "$attr.value",
   "trigger": "$attr.trigger",
   "resumable": "$attr.resumable",
   "kind": "$attr.flowKind",
   "steps": {
    "$out": "hasStep",
    "$sort": "attr.stepId",
    "$select": {
     "id": "$id",
     "name": "$label",
     "summary": "$summary",
     "type": "$type",
     "kind": "$attr.stepKind",
     "implemented": "$attr.isImplemented",
     "retries": "$attr.retryMax",
     "options": "$attr.decisionOption",
     "required": "$attr.requiredField",
     "waits": {
      "$out": "waitsFor",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "after": {
      "$out": "after",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "reads": {
      "$out": "reads",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "maybe": {
      "$out": "readsOptional",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "writes": {
      "$out": "writes",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "checks": {
      "$out": "hasCheck",
      "$select": {
       "id": "$id",
       "name": "$label",
       "blocking": "$attr.blocking",
       "kind": "$attr.checkKind"
      }
     },
     "phase": {
      "$out": "inPhase",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "implementation": {
      "$out": "implementedBy",
      "$select": {
       "id": "$id",
       "name": "$label",
       "exists": "$attr.exists"
      }
     },
     "outcomes": {
      "$out": "hasOutcome",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "settings": {
      "$out": "usesParameter",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "depends": {
      "$out": "dependsOn",
      "$select": {
       "id": "$id",
       "name": "$label"
      }
     },
     "owed": {
      "$in": "forStep",
      "$select": {
       "id": "$id",
       "name": "$label",
       "kind": "$attr.obligationKind"
      }
     },
     "next": {
      "$in": "from",
      "$select": {
       "id": "$id",
       "name": "$label",
       "to": {
        "$out": "to",
        "$select": {
         "id": "$id",
         "name": "$label"
        }
       },
       "on": {
        "$out": "onOutcome",
        "$select": {
         "id": "$id",
         "name": "$label"
        }
       }
      }
     },
     "stepId": "$attr.stepId"
    }
   }
  }
 },
