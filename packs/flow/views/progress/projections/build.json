     }
    }
   },
   "flow": {
    "$in": "hasStep",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   },
   "stepId": "$attr.stepId"
  }
 },
 "phases": {
  "$nodes": "Phase",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "name": "$label",
   "summary": "$summary",
   "starts": {
    "$out": "entrypoint",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   },
   "steps": {
    "$in": "inPhase",
    "$select": {
     "id": "$id",
     "name": "$label"
    }
   }
  }
 },
 "artifacts": {
  "$nodes": "Artifact",
