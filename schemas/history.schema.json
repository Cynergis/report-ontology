{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cynergis.ai/schema/docgen/history/2.1.0",
  "title": "semantic/history.yaml — every accepted revision of a report's definition",
  "description": "Written by `semantic.py accept`, never by hand. Revision 1 holds every fact of the definition as first accepted; each later revision the facts it added, changed or removed. Integrity (numbering, order, each change starting from the value the history holds) is checked by ledger.py.",
  "x-ontology": "https://cynergis.ai/ont/report",
  "x-ontology-version": "2.1.0",
  "type": "object", "additionalProperties": false, "required": ["revisions"],
  "properties": {
    "revisions": {
      "type": "array", "minItems": 1, "x-term": "rpt:hasRevision",
      "items": {
        "type": "object", "additionalProperties": false, "x-class": "rpt:Revision",
        "required": ["revision", "at", "by", "why"],
        "properties": {
          "revision":  {"type": "integer", "minimum": 1, "x-term": "rpt:order"},
          "at":        {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}", "x-term": "rpt:at"},
          "by":        {"type": "string", "pattern": "^[^<]", "minLength": 1, "x-term": "rpt:changedBy"},
          "why":       {"type": "string", "minLength": 3, "x-term": "rpt:reason"},
          "effective": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "x-term": "rpt:effectiveFrom"},
          "facts":     {"type": "object", "x-structural": true, "description": "revision 1 only: every fact of the definition, by file and path → value"},
          "changes": {
            "type": "array", "x-term": "rpt:hasChange",
            "items": {
              "type": "object", "additionalProperties": false, "x-class": "rpt:Change", "required": ["fact", "kind"],
              "properties": {
                "fact": {"type": "string", "x-term": "rpt:fact"},
                "kind": {"type": "string", "enum": ["added", "changed", "removed"], "x-term": "rpt:changeKind"},
                "from": {"x-term": "rpt:previousValue"},
                "to":   {"x-term": "rpt:newValue"}
              },
              "allOf": [
                {"if": {"properties": {"kind": {"const": "added"}}}, "then": {"required": ["to"], "not": {"required": ["from"]}}},
                {"if": {"properties": {"kind": {"const": "changed"}}}, "then": {"required": ["from", "to"]}},
                {"if": {"properties": {"kind": {"const": "removed"}}}, "then": {"required": ["from"], "not": {"required": ["to"]}}}
              ]
            }
          }
        }
      }
    }
  }
}
